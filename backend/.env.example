# Copy to backend/.env and adjust. All values have development defaults (see app/config.py).
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://safiri:safiri@localhost:5434/safiri_nasi

# Where the website lives (used in emails and payment redirects)
FRONTEND_URL=http://localhost:3000
# Public URL of this API. Safaricom/Airtel/DPO must reach it for callbacks
# (use a tunnel such as `cloudflared tunnel --url http://localhost:8000` when testing sandboxes).
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
# COOKIE_DOMAIN=.safirinasitourstravel.co.ke

# Email (Mailpit in docker-compose catches everything locally: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM="Safiri Nasi <bookings@safirinasitourstravel.co.ke>"
ADMIN_NOTIFY_EMAIL=admin@safirinasitourstravel.co.ke

# Payments: mock | sandbox | live
PAYMENTS_MODE=mock
# paystack (default): M-Pesa, Airtel Money and cards through Paystack with an automatic revenue split
# direct: Safaricom Daraja + Airtel Open API + DPO Pay (settings further down)
PAYMENT_GATEWAY=paystack

# Paystack: Settings → API Keys & Webhooks on dashboard.paystack.com (Safiri Nasi's account).
# Use sk_test_… with PAYMENTS_MODE=sandbox and sk_live_… with live.
# Webhook URL to enter in Paystack: <PUBLIC_API_URL>/api/callbacks/paystack
PAYSTACK_SECRET_KEY=
# Revenue split: Astralyn's Paystack subaccount code (ACCT_…, created under Safiri Nasi's account
# in Paystack → Subaccounts) and its percentage of every online payment. Paystack's own fee is
# charged to Safiri Nasi. No split is sent until the subaccount code is set.
PLATFORM_PARTNER_NAME=Astralyn
PAYSTACK_PLATFORM_SUBACCOUNT=
PAYSTACK_PLATFORM_PERCENT=5
# Mobile money provider code Paystack uses for Airtel Money in Kenya (confirm in test mode)
PAYSTACK_AIRTEL_PROVIDER=airtel
# Random string embedded in every callback URL; rotate if leaked.
CALLBACK_SECRET=change-me-callback-secret

# M-Pesa Daraja (https://developer.safaricom.co.ke). Sandbox defaults to shortcode 174379.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till (set MPESA_TILL_NUMBER too)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TILL_NUMBER=
# Optional allow-list of Safaricom callback IPs, e.g. ["196.201.214.200","196.201.214.206"]
MPESA_ALLOWED_IPS=[]

# Airtel Money (https://developers.airtel.africa)
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COLLECTION_PATH=/merchant/v1/payments/
AIRTEL_CALLBACK_SECRET=

# DPO Pay cards (company token and service type from your DPO account manager)
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_PAYMENT_TIME_LIMIT_HOURS=2

SEED_ADMIN_EMAIL=admin@safirinasitourstravel.co.ke
SEED_ADMIN_PASSWORD=SafiriAdmin#2026
